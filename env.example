# Supabase Configuration
# Copy this file to .env for local testing (optional)

# Multiple Supabase databases configuration
# Format: JSON array of database objects
# Each object should have: name (optional), url, key, and preferably rpc
# Optional: enabled:false to skip a project without deleting it

# Recommended example for single database:
# SUPABASE_CONFIGS='[{"name":"Production DB","url":"https://xxxxx.supabase.co","key":"service_role_or_other_allowed_key","rpc":"keepalive_ping"}]'

# Example for multiple databases:
# SUPABASE_CONFIGS='[{"name":"Production DB","url":"https://xxxxx.supabase.co","key":"key1","rpc":"keepalive_ping"},{"name":"Staging DB","url":"https://yyyyy.supabase.co","key":"key2","rpc":"keepalive_ping"}]'

# Legacy fallback without rpc:
# SUPABASE_CONFIGS='[{"name":"Legacy DB","url":"https://xxxxx.supabase.co","key":"your_supabase_key_here"}]'

# Disabled project example:
# SUPABASE_CONFIGS='[{"name":"Old DB","url":"https://xxxxx.supabase.co","key":"old_key","enabled":false}]'

SUPABASE_CONFIGS='[{"name":"My Database","url":"https://xxxxxxxxxxxxx.supabase.co","key":"your_supabase_key_here","rpc":"keepalive_ping"}]'
